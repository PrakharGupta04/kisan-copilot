# ---- LLM: Gemini free tier (Google AI Studio). Real keys go in .env, never here. ----
GOOGLE_API_KEY=
GEMINI_API_KEY=
CREW_MODEL=gemini/gemini-3.5-flash-lite
ADK_MODEL=gemini-3.5-flash-lite

# ---- Quota: free-tier limits read from AI Studio on 2026-11-07 for gemini-3.5-flash-lite:
# ---- 15 RPM, 250K TPM, 500 RPD (resets midnight US Pacific). Values below keep a safety margin.
# ---- NOTE: the non-lite Flash models only allow 20 requests/day, so do NOT use them in the pipeline.
GEMINI_RPM=12
GEMINI_RPD=450
GEMINI_TPM=200000
MAX_RPM=12
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# ---- Pipeline ----
TOOL_MODE=prefetch
OFFLINE=0
RUN_TIMEOUT=300
MCP_TOOL_TIMEOUT=60
A2A_TIMEOUT=90
ADK_POLL_TIMEOUT=45
INSURANCE_A2A_URL=http://localhost:8001
A2A_PORT=8001

# ---- Optional ----
DATA_GOV_API_KEY=
API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
