# Copy to .env and fill in. NEVER commit .env. Rotate any key that was ever pasted into a chat or a log.
GOOGLE_API_KEY=
DATA_GOV_API_KEY=
# Models (free tier gemini-3.5-flash-lite: 15 RPM, 500 RPD, 250K TPM per Google AI Studio)
CREW_MODEL=gemini/gemini-3.5-flash-lite
ADK_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini/gemini-3.1-flash-lite
GEMINI_RPM=12
GEMINI_RPD=450
GEMINI_TPM=200000
# Cost estimate only (free tier = 0)
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0
# Pipeline
TOOL_MODE=prefetch
OFFLINE=0
RUN_TIMEOUT=300
MCP_TOOL_TIMEOUT=60
A2A_TIMEOUT=90
ADK_POLL_TIMEOUT=45
INSURANCE_A2A_URL=http://localhost:8001
A2A_PORT=8001
KISAN_VERBOSE=0
# Optional
API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
